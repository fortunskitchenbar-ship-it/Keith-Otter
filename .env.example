# ---------------------------------------------------------------------------
# Keith · Command Center — environment variables
# Copy to `.env.local` for local development. Set the same names in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real keys.
# ---------------------------------------------------------------------------

# AI (primary). Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# AI (fallback). Optional — used if DeepSeek is unset or failing.
GEMINI_API_KEY=

# Market data needs no key (Yahoo Finance + CoinGecko, both public).

# Optional cross-device sync (Supabase)
# Run automation/supabase/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the browser sends as x-sync-token. Pick a long random string.
DASHBOARD_SYNC_TOKEN=

# Optional: raises GitHub API limits for the Ops panel (public data only).
GITHUB_TOKEN=

# Optional: shown in the Automations panel when n8n is wired up.
N8N_WEBHOOK_URL=
