{
  "name": "Keith Command Center — data refresh",
  "nodes": [
    {
      "parameters": {
        "content": "## Keith Command Center — n8n refresh\n\nOptional alternative to the GitHub Actions cron.\n\n1. Set n8n env vars: `SUPABASE_URL`, `SUPABASE_SERVICE_KEY`, `COMMAND_CENTER_SYNC_TOKEN`.\n2. Run `automation/supabase/schema.sql` in Supabase.\n3. Import this workflow and activate it.\n4. The dashboard reads the same Supabase row through `/api/state` (token-gated).\n\nSchedule: 6:30 / 11:30 / 16:30 / 21:30 Pacific (UTC cron, adjust at DST).",
        "height": 260,
        "width": 380
      },
      "id": "note-setup",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-880, 40]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 13,18,23,4 * * *"
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every 4 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-440, -40]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "keith-command-center-refresh",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger-webhook",
      "name": "Manual webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-440, 160],
      "webhookId": "keith-command-center-refresh"
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast?latitude=33.6639&longitude=-116.3108&current=temperature_2m,apparent_temperature,relative_humidity_2m,is_day,precipitation,weather_code,wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=America%2FLos_Angeles&forecast_days=7",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "http-weather",
      "name": "Open-Meteo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, -40]
    },
    {
      "parameters": {
        "url": "https://moxie.foxnews.com/google-publisher/latest.xml",
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-rss",
      "name": "Headlines RSS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, -40]
    },
    {
      "parameters": {
        "jsCode": "// Build one compact snapshot for the dashboard.\nconst weather = $('Open-Meteo').first().json;\nconst rss = $('Headlines RSS').first().json;\n\nconst titles = String(rss.data || rss.body || '')\n  .split('<item')\n  .slice(1, 6)\n  .map(chunk => {\n    const title = (chunk.match(/<title>(.*?)<\\/title>/s) || [])[1] || '';\n    const link = (chunk.match(/<link>(.*?)<\\/link>/s) || [])[1] || '';\n    return { title: title.replace(/<!\\\\[CDATA\\\\[|\\\\]\\\\]>/g, '').trim(), link: link.trim() };\n  })\n  .filter(item => item.title && item.link);\n\nconst current = weather.current || {};\nconst daily = weather.daily || {};\n\nreturn [{\n  json: {\n    version: 2,\n    updatedAt: new Date().toISOString(),\n    weather: {\n      temp: Math.round(current.temperature_2m),\n      feels: Math.round(current.apparent_temperature),\n      humidity: current.relative_humidity_2m,\n      wind: current.wind_speed_10m,\n      code: current.weather_code,\n      high: Math.round((daily.temperature_2m_max || [])[0]),\n      low: Math.round((daily.temperature_2m_min || [])[0])\n    },\n    headlines: titles\n  }\n}];"
      },
      "id": "code-compose",
      "name": "Compose snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, -40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/dashboard_state?on_conflict=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: 'keith', data: $json, updated_at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-supabase",
      "name": "Save to Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, -40]
    }
  ],
  "connections": {
    "Every 4 hours": {
      "main": [
        [
          { "node": "Open-Meteo", "type": "main", "index": 0 }
        ]
      ]
    },
    "Manual webhook": {
      "main": [
        [
          { "node": "Open-Meteo", "type": "main", "index": 0 }
        ]
      ]
    },
    "Open-Meteo": {
      "main": [
        [
          { "node": "Headlines RSS", "type": "main", "index": 0 }
        ]
      ]
    },
    "Headlines RSS": {
      "main": [
        [
          { "node": "Compose snapshot", "type": "main", "index": 0 }
        ]
      ]
    },
    "Compose snapshot": {
      "main": [
        [
          { "node": "Save to Supabase", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
